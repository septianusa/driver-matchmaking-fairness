data/generated_small_check/*
reports/figures/*
!reports/figures/.gitkeep
reports/validation_summary.md
*.pyc
__pycache__/
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.venv/
dist/
build/
*.egg-info/
